#!/usr/bin/env bash
# Description: Modular application injector with smart command/URL detection.
# Naming Standard: snake_case formatting for custom local bin binaries.

set -euo pipefail

fzf_select() {
    local prompt="$1"
    shift
    local choice
    # fzf returns exit code 130 on ESC or Ctrl+C, caught cleanly by the || block
    # </dev/tty ensures fzf has direct access to terminal keystrokes inside subshells
    choice=$(printf '%s\n' "$@" | fzf \
        --prompt "$prompt: " \
        --height "35%" \
        --layout "reverse" \
        --border "rounded" \
        --info "inline" \
        --margin "1%" \
        --color "bg:-1,bg+:#11111b,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,prompt:#89b4fa,hl+:#f38ba8,border:#313244" </dev/tty) || {
        echo -e "\nExiting."
        exit 0
    }
    echo "$choice"
}

get_text_input() {
    local prompt_msg="$1"
    local val=""
    
    echo -ne "\033[34m→\033[0m ${prompt_msg}: " >&2
    read -r val
    
    val=$(echo "$val" | xargs) # Trim spaces
    if [[ -z "$val" ]]; then
        echo "Value cannot be empty." >&2
        exit 1
    fi
    echo "$val"
}

main() {
    # 1. Gather core metadata
    local name
    name=$(get_text_input "App Name")

    local target
    target=$(get_text_input "Command or URL (e.g., 'libreoffice', 'htop', or 'https://notion.so')")

    local exec_cmd=""
    local icon=""

    # 2. Smart Detection: Handle Web URLs vs System Commands
    if [[ "$target" =~ ^https?:// ]]; then
        # Web App Workflow triggered automatically by URL pattern
        local chosen_web
        chosen_web=$(fzf_select "🌐 Opening Mode" \
            "Browser App Mode (Standalone window)" \
            "Default Browser (Standard tab)")

        if [[ "$chosen_web" == *"App Mode"* ]]; then
            exec_cmd="google-chrome --app=${target} || chromium --app=${target} || brave --app=${target} || xdg-open ${target}"
        else
            exec_cmd="xdg-open ${target}"
        fi
        icon="web-browser"
    else
        # System Command Workflow: Ask execution environment via styled fzf
        local chosen_run
        chosen_run=$(fzf_select "⚙️ Execution Mode" \
            "Direct Execution (GUI / Standard CLI)" \
            "Run inside Terminal Emulator (TUI)")

        if [[ "$chosen_run" == *"Terminal Emulator"* ]]; then
            exec_cmd="sys_term -e $target"
            icon="utilities-terminal"
        else
            exec_cmd="$target"
            icon="application-default"
        fi
    fi

    # 3. Sanitize and prepare desktop entry file structures
    local safe_filename
    safe_filename=$(echo "$name" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')
    safe_filename="${safe_filename:-app}.desktop"

    local output_dir="${HOME}/.local/share/applications"
    mkdir -p "$output_dir"
    local file_path="${output_dir}/${safe_filename}"

    # Generate desktop schema block
    cat << EOF > "$file_path"
[Desktop Entry]
Type=Application
Name=${name}
Exec=${exec_cmd}
Icon=${icon}
Terminal=false
Categories=Utility;Application;
EOF

    chmod +x "$file_path"

    # Silently clear compositor/launcher application caches 
    update-desktop-database "$output_dir" >/dev/null 2>&1 || true

    echo -e "\n\033[32m✔ Success!\033[0m Added \033[1m${name}\033[0m to your launcher."
}

main "$@"
