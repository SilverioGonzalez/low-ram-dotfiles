#!/usr/bin/env bash
# Description: Interactive TUI Task Manager powered by fzf and JSON.
# Naming Standard: snake_case formatting.

set -euo pipefail

# Configuration paths
DATA_DIR="${HOME}/.local/share/task_manager"
DATA_FILE="${DATA_DIR}/tasks.json"

# Ensure storage exists
init_storage() {
    mkdir -p "$DATA_DIR"
    if [[ ! -f "$DATA_FILE" ]]; then
        echo '[]' > "$DATA_FILE"
    fi
}

# Helper for styled fzf prompts with working ESC and item input support
fzf_select() {
    local prompt="$1"
    shift
    local choice
    choice=$(fzf \
        --prompt "$prompt: " \
        --height "35%" \
        --layout "reverse" \
        --border "rounded" \
        --info "inline" \
        --margin "1%" \
        --color "bg:-1,bg+:#11111b,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,prompt:#89b4fa,hl+:#f38ba8,border:#313244" \
        < <(printf '%s\n' "$@")) || return 1
    echo "$choice"
}

get_text_input() {
    local prompt_msg="$1"
    local val=""
    echo -ne "\033[34m→\033[0m ${prompt_msg}: " >&2
    read -r val
    val=$(echo "$val" | xargs) # Trim spaces
    echo "$val"
}

# Add a new task
add_task() {
    echo -e "\n\033[1m--- Add New Task ---\033[0m"
    local title
    title=$(get_text_input "Task Title")
    if [[ -z "$title" ]]; then
        echo -e "\033[31mTask title cannot be empty.\033[0m"
        return
    fi

    local description
    description=$(get_text_input "Task Description (optional)")

    local id
    id=$(date +%s%N) # Unique ID based on nanoseconds

    # Append to JSON using jq safely
    local temp_file
    temp_file=$(mktemp)
    jq --arg id "$id" \
       --arg title "$title" \
       --arg desc "$description" \
       '. += [{"id": $id, "title": $title, "description": $desc, "status": "Not Started"}]' \
       "$DATA_FILE" > "$temp_file" && mv "$temp_file" "$DATA_FILE"

    echo -e "\n\033[32m✔ Task added successfully!\033[0m"
}

# Manage an existing task (Change Status, View, Delete)
manage_task() {
    local task_id="$1"
    
    while true; do
        # Extract fresh task details
        local title status desc
        title=$(jq -r --arg id "$task_id" '.[] | select(.id == $id) | .title' "$DATA_FILE")
        status=$(jq -r --arg id "$task_id" '.[] | select(.id == $id) | .status' "$DATA_FILE")
        desc=$(jq -r --arg id "$task_id" '.[] | select(.id == $id) | .description' "$DATA_FILE")

        clear
        echo -e "\033[1mTask:\033[0m $title"
        echo -e "\033[1mStatus:\033[0m $status"
        echo -e "\033[1mDescription:\033[0m ${desc:-No description provided}"
        echo "----------------------------------------"

        local action
        action=$(fzf_select "⚙️ Action" \
            "Change Status" \
            "Delete Task" \
            "Back to Main Menu") || break

        case "$action" in
            "Change Status")
                local new_status
                new_status=$(fzf_select "📌 Select New Status" \
                    "Not Started" \
                    "In Progress" \
                    "Completed") || continue

                local temp_file
                temp_file=$(mktemp)
                jq --arg id "$task_id" --arg status "$new_status" \
                   'map(if .id == $id then .status = $status else . end)' \
                   "$DATA_FILE" > "$temp_file" && mv "$temp_file" "$DATA_FILE"
                echo -e "\n\033[32m✔ Status updated!\033[0m"
                sleep 1
                ;;
            "Delete Task")
                local confirm
                confirm=$(fzf_select "⚠️ Are you sure you want to delete this task?" "Yes" "No") || continue
                if [[ "$confirm" == "Yes" ]]; then
                    local temp_file
                    temp_file=$(mktemp)
                    jq --arg id "$task_id" 'map(select(.id != $id))' "$DATA_FILE" > "$temp_file" && mv "$temp_file" "$DATA_FILE"
                    echo -e "\n\033[31m🗑 Task deleted.\033[0m"
                    sleep 1
                    return
                fi
                ;;
            *)
                return
                ;;
        esac
    done
}

# Main Application Loop
main() {
    init_storage

    # Check dependencies
    for cmd in fzf jq; do
        if ! command -v "$cmd" &> /dev/null; then
            echo "Error: Required tool '$cmd' is not installed." >&2
            exit 1
        fi
    done

    while true; do
        clear
        echo -e "\033[1m=== TUI Task Manager ===\033[0m\n"

        # Build options array cleanly
        local options=("➕ Add New Task")
        
        # Read tasks safely via pipe-delimited output from jq
        if [[ -f "$DATA_FILE" ]] && [[ $(jq 'length' "$DATA_FILE") -gt 0 ]]; then
            while IFS='|' read -r status title; do
                [[ -z "$title" ]] && continue
                case "$status" in
                    "Completed")   options+=("[✔] $title (Completed)") ;;
                    "In Progress") options+=("[⏳] $title (In Progress)") ;;
                    *)             options+=("[ ] $title (Not Started)") ;;
                esac
            done < <(jq -r '.[] | "\(.status)|\(.title)"' "$DATA_FILE")
        fi

        options+=("🚪 Exit")

        local selection
        selection=$(fzf_select "📋 Tasks" "${options[@]}") || {
            echo -e "\nExiting."
            exit 0
        }

        if [[ "$selection" == "➕ Add New Task" ]]; then
            add_task
            read -n 1 -s -r -p "Press any key to continue..."
        elif [[ "$selection" == "🚪 Exit" ]]; then
            exit 0
        elif [[ -n "$selection" ]]; then
            # Extract clean title by stripping status prefix and suffix
            local clean_title
            clean_title=$(echo "$selection" | sed -E 's/^\[.\] //; s/ \((Not Started|In Progress|Completed)\)$//')

            # Find the ID corresponding to this title
            local task_id
            task_id=$(jq -r --arg title "$clean_title" '.[] | select(.title == $title) | .id' "$DATA_FILE" | head -n 1)

            if [[ -n "$task_id" ]]; then
                manage_task "$task_id"
            fi
        fi
    done
}

main "$@"
