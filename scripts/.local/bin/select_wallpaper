#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="$HOME/wallpaper"
HYPRPAPER_CONF="$HOME/.config/hypr/hyprpaper.conf"

# 1. Dependency & Daemon Checks
for cmd in fzf chafa hyprctl hyprpaper; do
  command -v "$cmd" &>/dev/null || {
    echo "Error: Required command '$cmd' is not installed." >&2
    exit 1
  }
done

pgrep -x "hyprpaper" &>/dev/null || {
  echo "Error: hyprpaper daemon is not running." >&2
  exit 1
}

[[ -d "$WALLPAPER_DIR" ]] || {
  echo "Error: Wallpaper directory '$WALLPAPER_DIR' does not exist." >&2
  exit 1
}

cd "$WALLPAPER_DIR" || exit 1

# 2. Launch FZF styled to match Hyprlauncher's aesthetic
PREVIEW_CMD="printf '\033_Ga=d,d=A\033\\'; chafa -f kitty -s \${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES} --animate false --polite on {}"

SELECTED=$(find . -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) |
  sort |
  fzf --preview="$PREVIEW_CMD" \
      --preview-window=right:50%:wrap,border-rounded \
      --prompt="Wallpaper > " \
      --layout=reverse \
      --border=rounded \
      --margin=2% \
      --color="bg:-1,bg+:#11111b,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,prompt:#89b4fa,hl+:#f38ba8,border:#313244")

[[ -z "${SELECTED:-}" ]] && {
  echo "No wallpaper selected."
  exit 0
}

FULL_PATH="$WALLPAPER_DIR/${SELECTED#./}"
MONITORS=$(hyprctl monitors | awk '/Monitor/{print $2}')

# 3. Apply live via Hyprpaper IPC
hyprctl hyprpaper preload "$FULL_PATH" >/dev/null 2>&1 || true
for mon in $MONITORS; do
  hyprctl hyprpaper wallpaper "$mon,$FULL_PATH"
done
hyprctl hyprpaper unload unused >/dev/null 2>&1 || true

# 4. Save persistent configuration
mkdir -p "$(dirname "$HYPRPAPER_CONF")"
[[ -f "$HYPRPAPER_CONF" ]] && cp "$HYPRPAPER_CONF" "$HYPRPAPER_CONF.bak"

{
  echo -e "# Generated by wall-picker\nipc = true\n"
  for mon in $MONITORS; do
    echo -e "wallpaper {\n    monitor = $mon\n    path = $FULL_PATH\n    fit_mode = cover\n}\n"
  done
} > "$HYPRPAPER_CONF"

echo -e "\n\033[32m✔ Success!\033[0m Applied wallpaper: $(basename "$FULL_PATH")"
